---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatBlogDate } from '../lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  emptyText?: string;
  titleTag?: 'h2' | 'h3';
}

const { posts, emptyText = 'No posts yet. Check back soon.', titleTag = 'h2' } = Astro.props;
const TitleTag = titleTag;
---

{posts.length === 0 ? (
  <p class="blog-empty">{emptyText}</p>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-card">
        <a href={`/blog/${post.slug}`} class:list={['post-card__link', post.data.heroImage && 'post-card__link--has-image']}>
          {post.data.heroImage && (
            <div class="post-card__image-wrap">
              <Image
                src={post.data.heroImage}
                alt={post.data.heroImageAlt ?? ''}
                class="post-card__image"
                widths={[440, 720, 1200]}
                sizes="(max-width: 639px) calc(100vw - 2.5rem), 220px"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="post-card__body">
            {post.data.category && (
              <p class="post-card__category">{post.data.category}</p>
            )}
            <TitleTag class="post-card__title">{post.data.title}</TitleTag>
            <p class="post-card__desc">{post.data.description}</p>
            <p class="post-card__meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatBlogDate(post.data.pubDate)}
              </time>
            </p>
          </div>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .blog-empty {
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    border-bottom: 1px solid var(--rule);
  }

  .post-card:first-child {
    border-top: 1px solid var(--rule);
  }

  .post-card__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 1.75rem 0;
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 640px) {
    .post-card__link--has-image {
      grid-template-columns: 220px 1fr;
      align-items: start;
    }
  }

  .post-card__image-wrap {
    border-radius: var(--radius, 8px);
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  .post-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .post-card__link:hover .post-card__image {
    transform: scale(1.02);
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .post-card__category {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--copper, #b26a43);
    margin: 0;
  }

  .post-card__title {
    font-family: var(--serif);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--ink);
    margin: 0;
  }

  .post-card__link:hover .post-card__title {
    color: var(--copper-deep, var(--copper));
  }

  .post-card__desc {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
    margin: 0.25rem 0 0;
  }

  .post-card__meta {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    margin: 0.5rem 0 0;
    opacity: 0.7;
  }
</style>
