---
import game from '../../../../shared/game.json';
import BlogShell from '../../layouts/BlogShell.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
const description = 'Thoughts on mindfulness, creativity, and making Serenity Sketch.';
---

<BlogShell title={`Brushstrokes | ${game.name}`} description={description} canonical="https://serenitysketch.com/blog/">
  <main id="main">
    <section class="blog-index-header">
      <div class="container">
        <p class="section-eyebrow">Blog</p>
        <h1 class="display">Brushstrokes</h1>
        <p class="blog-index-lead">{description}</p>
      </div>
    </section>

    <section class="blog-index-list">
      <div class="container">
        <PostList posts={posts} />
      </div>
    </section>
  </main>

  <style>
    .blog-index-header {
      padding: clamp(1.1rem, 2vw, 1.6rem) 0 0.75rem;
      border-bottom: 1px solid var(--rule);
      text-align: left;
    }

    .blog-index-lead {
      color: var(--ink-soft);
      font-size: 1.0625rem;
      margin-top: 0.75rem;
      max-width: 520px;
    }

    .blog-index-list {
      padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(3rem, 6vw, 5rem);
    }
  </style>
</BlogShell>
